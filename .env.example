# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings -> API). Use the project's HTTPS API URL here
# (https://<ref>.supabase.co), NOT the direct Postgres connection string —
# supabase-js needs the REST URL, and this var is exposed to the browser via
# the NEXT_PUBLIC_ prefix, so a Postgres connection string here would leak
# your database password to every visitor. The anon key is public by design
# (RLS restricts it to insert/update-only on analytics tables — see
# supabase/migrations/0001_analytics_and_contact.sql) and is safe in
# client-side bundles via the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key. Server-only — used by src/app/api/contact/route.ts to
# write contact_messages, which has no anon RLS policy. NEVER prefix this
# with NEXT_PUBLIC_ and never reference it from a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Calendly scheduling page URL, e.g. https://calendly.com/novuslabs/intro.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-org/intro

# Optional: enables email notifications on new contact submissions via
# Resend (resend.com). If unset, submissions are still stored in
# contact_messages and the form still succeeds — email is a notification
# convenience, not the source of truth.
RESEND_API_KEY=your-resend-api-key
CONTACT_NOTIFICATION_EMAIL=you@example.com
